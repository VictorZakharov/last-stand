{
  "name": "last-stand",
  "version": "0.1.0",
  "private": true,
  "description": "Last Stand - a 3D wave-survival ARPG arena in the browser (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:pages": "node scripts/check-pages-build.mjs",
    "preview": "vite preview",
    "facelab": "node tools/facelab/facelab.mjs",
    "lab": "node tools/lab/lab.mjs",
    "lab:serve": "node tools/lab/lab.mjs serve",
    "lab:test": "node --test \"tools/lab/test/*.test.mjs\""
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "@types/three": "0.185.4",
    "playwright-core": "^1.61.1",
    "sass": "^1.105.0",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
